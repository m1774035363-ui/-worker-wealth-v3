<script>
const MVC = {
    Model: {
        state: {
            city: 'beijing',
            salary: { monthly: 15000, hfRate: 12, baseType: 'actual', hasAnnuity: false },
            deductions: {
                edu: { active: false, value: 2000, name: '子女教育', icon: 'fa-child' },
                rent: { active: false, value: 1500, name: '租房', icon: 'fa-house-user' },
                mortgage: { active: false, value: 1000, name: '房贷利息', icon: 'fa-file-signature' },
                old: { active: false, value: 3000, name: '赡养老人', icon: 'fa-person-cane' },
                baby: { active: false, value: 2000, name: '婴幼儿', icon: 'fa-baby' }
            },
            incomes: { bonus: 30000, bonusTaxMode: 'separate', side: 0 },
            expensesList: [
                { id: 'e1', name: '🏠 房租/房贷', amount: 3000 },
                { id: 'e2', name: '🍔 餐饮', amount: 1500 },
                { id: 'e3', name: '🚌 交通', amount: 500 }
            ],
            mortgage: { cAmount: 120, cRate: 3.6, fAmount: 80, fRate: 2.85, years: 30, paidMonths: 12 },
            goalsList: [
                { id: 'g1', name: '🚗 提一辆新车', amount: 200000 },
                { id: 'g2', name: '🏠 买房首付', amount: 1000000 },
                { id: 'g3', name: '✈️ 环游世界', amount: 50000 }
            ],
            activeGoalId: 'g1',
            retire: { birthYear: 1990, type: 'male' }
        },
        
        constants: {
            cities: {
                'beijing': { name: '北京', minBase: 6326, maxBase: 33891, defaultHf: 12 },
                'shanghai': { name: '上海', minBase: 7310, maxBase: 36549, defaultHf: 7 },
                'shenzhen': { name: '深圳', minBase: 3523, maxBase: 31200, defaultHf: 5 },
                'guangzhou': { name: '广州', minBase: 3800, maxBase: 38082, defaultHf: 5 },
                'hangzhou': { name: '杭州', minBase: 3957, maxBase: 24060, defaultHf: 12 },
                'chengdu': { name: '成都', minBase: 4246, maxBase: 21228, defaultHf: 12 },
                'wuhan': { name: '武汉', minBase: 3740, maxBase: 21114, defaultHf: 8 },
                'xian': { name: '西安', minBase: 3800, maxBase: 20000, defaultHf: 12 },
                'custom': { name: '自定义', minBase: 4000, maxBase: 25000, defaultHf: 8 }
            }
        },

        cache: {
            annualNet: 0, annualSave: 0, netMonthly: 0, specDeductMonth: 0,
            compensationMonthly: 0, secMonthly: 0,
            monthlyIn: 0, monthlyOut: 0, monthlySave: 0, monthlySaveRate: 0
        },

        save() { localStorage.setItem('worker_wealth_v3', JSON.stringify(this.state)); },
        load() {
            const saved = localStorage.getItem('worker_wealth_v3');
            if (saved) { try { this.state = {...this.state, ...JSON.parse(saved)}; } catch(e){} }
        }
    },

    Controller: {
        init() {
            MVC.Model.load();
            if(!MVC.Model.state.expensesList) MVC.Model.state.expensesList = [{ id: 'e1', name: '总开销', amount: 5000 }];
            if(!MVC.Model.state.goalsList) MVC.Model.state.goalsList = [{ id: 'g1', name: '默认目标', amount: 200000 }];
            
            this.bindUIParams();
            this.populateCities();
            this.renderDeductions();
            this.renderExpenses();
            this.renderGoals();
            this.calculateAll();
        },

        updateModel(module, key, val) {
            MVC.Model.state[module][key] = val;
            this.calculateAll();
        },

        bindUIParams() {
            const s = MVC.Model.state;
            document.getElementById('city-select').value = s.city;
            document.getElementById('salary-input').value = s.salary.monthly;
            document.getElementById('hf-rate').value = s.salary.hfRate;
            document.getElementById('base-type').value = s.salary.baseType;
            document.getElementById('bonus-input').value = s.incomes.bonus;
            document.getElementById('annuity-check').checked = s.salary.hasAnnuity || false;
            document.getElementById('monthly-side-input').value = s.incomes.side || 0;
            
            document.getElementById('c-amount').value = s.mortgage.cAmount;
            document.getElementById('c-rate').value = s.mortgage.cRate;
            document.getElementById('f-amount').value = s.mortgage.fAmount;
            document.getElementById('f-rate').value = s.mortgage.fRate;
            document.getElementById('m-years').value = s.mortgage.years;
            document.getElementById('m-paid').value = s.mortgage.paidMonths;

            document.getElementById('r-birth').value = s.retire.birthYear;
            document.getElementById('r-type').value = s.retire.type;
        },

        populateCities() {
            const select = document.getElementById('city-select');
            select.innerHTML = '';
            for (let k in MVC.Model.constants.cities) {
                let opt = document.createElement('option');
                opt.value = k; opt.text = MVC.Model.constants.cities[k].name;
                select.add(opt);
            }
            select.value = MVC.Model.state.city;
        },

        changeCity(cityKey) {
            MVC.Model.state.city = cityKey;
            const cityData = MVC.Model.constants.cities[cityKey];
            MVC.Model.state.salary.hfRate = cityData.defaultHf;
            document.getElementById('hf-rate').value = cityData.defaultHf;
            this.calculateAll();
        },

        renderDeductions() {
            const container = document.getElementById('deductions-container');
            const deductions = MVC.Model.state.deductions;
            container.innerHTML = '';
            for(let key in deductions) {
                const item = deductions[key];
                const isActive = typeof item === 'boolean' ? item : item.active;
                const val = typeof item === 'boolean' ? 2000 : item.value;
                const name = typeof item === 'boolean' ? key : item.name;
                const icon = typeof item === 'boolean' ? 'fa-check' : item.icon;
                
                const div = document.createElement('div');
                div.className = `flex items-center justify-between p-2 rounded-lg border-2 border-[var(--c-outline)] transition-colors ${isActive ? 'bg-[var(--c-krabby)]' : 'bg-white'}`;
                div.innerHTML = `
                    <label class="flex items-center gap-2 cursor-pointer text-sm font-bold flex-1">
                        <input type="checkbox" ${isActive ? 'checked' : ''} class="w-4 h-4 accent-[var(--c-ketchup)]" onchange="MVC.Controller.toggleDeduction('${key}', this.checked)">
                        <i class="fa-solid ${icon} w-4 text-center"></i> <span>${name}</span>
                    </label>
                    <input type="number" class="kb-input kb-input-small w-20 text-center text-sm font-mono ml-2 !p-1 bg-white" value="${val}" ${isActive ? '' : 'disabled style="opacity:0.5"'} oninput="MVC.Controller.updateDeductionVal('${key}', this.value)">
                `;
                container.appendChild(div);
            }
        },

        toggleDeduction(key, isChecked) {
            if(typeof MVC.Model.state.deductions[key] === 'boolean') {
                MVC.Model.state.deductions[key] = { active: isChecked, value: 2000, name: key, icon: 'fa-check' };
            } else {
                MVC.Model.state.deductions[key].active = isChecked;
            }
            this.renderDeductions();
            this.calculateAll();
        },

        updateDeductionVal(key, val) {
            if(MVC.Model.state.deductions[key] && typeof MVC.Model.state.deductions[key] !== 'boolean') {
                MVC.Model.state.deductions[key].value = Number(val) || 0;
                this.calculateAll();
            }
        },

        renderExpenses() {
            const list = document.getElementById('expense-list');
            list.innerHTML = '';
            MVC.Model.state.expensesList.forEach((exp) => {
                const div = document.createElement('div');
                div.className = 'flex items-center gap-2 bg-gray-50 p-2 rounded-lg border border-gray-200';
                div.innerHTML = `
                    <input type="text" class="kb-input kb-input-small text-sm flex-1 !p-1.5" value="${exp.name}" onchange="MVC.Controller.updateExp('${exp.id}','name',this.value)">
                    <input type="number" class="kb-input kb-input-small text-sm w-24 text-center !p-1.5 font-mono" value="${exp.amount}" oninput="MVC.Controller.updateExp('${exp.id}','amount',this.value)">
                    <button onclick="MVC.Controller.removeExp('${exp.id}')" class="kb-btn kb-btn-red kb-btn-small !px-2"><i class="fa-solid fa-trash text-xs"></i></button>
                `;
                list.appendChild(div);
            });
            this.updateExpenseTotal();
        },
        updateExpenseTotal() {
            let total = 0;
            MVC.Model.state.expensesList.forEach(exp => total += (Number(exp.amount) || 0));
            document.getElementById('v-exp-val').innerText = '¥' + total.toLocaleString();
        },
        updateExp(id, key, val) {
            const item = MVC.Model.state.expensesList.find(e => e.id === id);
            if(item) {
                item[key] = key === 'amount' ? (Number(val) || 0) : val;
                this.calculateAll();
                if(key==='name') this.renderExpenses();
                if(key==='amount') this.updateExpenseTotal();
            }
        },
        addExpense() {
            MVC.Model.state.expensesList.push({ id: '_' + Math.random().toString(36).substr(2, 9), name: '🆕 新支出账目', amount: 500 });
            this.renderExpenses(); this.calculateAll();
        },
        removeExp(id) {
            MVC.Model.state.expensesList = MVC.Model.state.expensesList.filter(e => e.id !== id);
            this.renderExpenses(); this.calculateAll();
        },

        renderGoals() {
            const list = document.getElementById('goals-list');
            list.innerHTML = '';
            const state = MVC.Model.state;
            state.goalsList.forEach(goal => {
                const isActive = state.activeGoalId === goal.id;
                const btn = document.createElement('div');
                btn.className = `flex items-center gap-1 kb-btn kb-btn-small ${isActive ? 'active' : 'bg-white'}`;
                btn.innerHTML = `
                    <span class="cursor-pointer font-bold" onclick="MVC.Controller.setActiveGoal('${goal.id}')">${goal.name}</span>
                    <i class="fa-solid fa-xmark text-gray-400 hover:text-red-600 ml-1 cursor-pointer" onclick="MVC.Controller.removeGoal('${goal.id}')"></i>
                `;
                list.appendChild(btn);
            });
            
            const activeGoal = state.goalsList.find(g => g.id === state.activeGoalId);
            if (activeGoal) {
                document.getElementById('v-goal-name').innerText = "当前测算: " + activeGoal.name;
                document.getElementById('v-goal-amount-display').innerText = activeGoal.amount.toLocaleString();
            } else {
                document.getElementById('v-goal-name').innerText = "未选择目标";
                document.getElementById('v-goal-amount-display').innerText = "0";
            }
        },
        addGoal() {
            const nameInp = document.getElementById('new-goal-name');
            const amtInp = document.getElementById('new-goal-amount');
            const name = nameInp.value.trim() || '未命名目标';
            const amount = Number(amtInp.value) || 10000;
            const id = '_' + Math.random().toString(36).substr(2, 9);
            MVC.Model.state.goalsList.push({ id, name, amount });
            MVC.Model.state.activeGoalId = id;
            nameInp.value = ''; amtInp.value = '';
            this.renderGoals(); this.calculateAll();
        },
        removeGoal(id) {
            MVC.Model.state.goalsList = MVC.Model.state.goalsList.filter(g => g.id !== id);
            if (MVC.Model.state.activeGoalId === id && MVC.Model.state.goalsList.length > 0) {
                MVC.Model.state.activeGoalId = MVC.Model.state.goalsList[0].id;
            } else if (MVC.Model.state.goalsList.length === 0) {
                MVC.Model.state.activeGoalId = null;
            }
            this.renderGoals(); this.calculateAll();
        },
        setActiveGoal(id) {
            MVC.Model.state.activeGoalId = id;
            this.renderGoals(); this.calculateAll();
        },

        calculateAll() {
            MVC.Model.save();
            this.calcSalaryAndTax();
            this.calcMortgage();
            this.calcRetirement();
            this.calcProjections();
            this.generateAlerts();
            
            document.querySelectorAll('.btn-tax-mode').forEach(b => b.classList.toggle('active', b.dataset.val === MVC.Model.state.incomes.bonusTaxMode));
            document.getElementById('early-repay-result').style.display = 'none';
        },

        calcTaxRate(taxable) {
            if (taxable<=0) return {rate:0, deduct:0};
            if (taxable<=36000) return {rate:0.03, deduct:0};
            if (taxable<=144000) return {rate:0.1, deduct:2520};
            if (taxable<=300000) return {rate:0.2, deduct:16920};
            if (taxable<=420000) return {rate:0.25, deduct:31920};
            if (taxable<=660000) return {rate:0.3, deduct:52920};
            if (taxable<=960000) return {rate:0.35, deduct:85920};
            return {rate:0.45, deduct:181920};
        },
        
        calcMonthlyBonusTaxRate(monthlyBonus) {
            if (monthlyBonus<=0) return {rate:0, deduct:0};
            if (monthlyBonus<=3000) return {rate:0.03, deduct:0};
            if (monthlyBonus<=12000) return {rate:0.1, deduct:210};
            if (monthlyBonus<=25000) return {rate:0.2, deduct:1410};
            if (monthlyBonus<=35000) return {rate:0.25, deduct:2660};
            if (monthlyBonus<=55000) return {rate:0.3, deduct:4410};
            if (monthlyBonus<=80000) return {rate:0.35, deduct:7160};
            return {rate:0.45, deduct:15160};
        },

        calcSalaryAndTax() {
            const st = MVC.Model.state;
            const cityData = MVC.Model.constants.cities[st.city];
            const mGross = st.salary.monthly;
            
            // 1. 确定社保基数
            let base = mGross;
            if(st.salary.baseType === 'min') base = cityData.minBase;
            if(st.salary.baseType === 'max') base = cityData.maxBase;
            base = Math.max(cityData.minBase, Math.min(cityData.maxBase, base));

            // 2. 五险二金 个人与企业部分详细计算
            const details = {
                pen: { p: base * 0.08, c: base * 0.16, name: '养老保险(8%|16%)' },
                med: { p: base * 0.02, c: base * 0.09, name: '医疗保险(2%|9%)' },
                unemp: { p: base * 0.005, c: base * 0.005, name: '失业保险(0.5%)' },
                inj: { p: 0, c: base * 0.004, name: '工伤保险(0|0.4%)' },
                mat: { p: 0, c: base * 0.008, name: '生育保险(0|0.8%)' },
                hf: { p: base * (st.salary.hfRate/100), c: base * (st.salary.hfRate/100), name: `公积金(${st.salary.hfRate}%)` },
                annuity: { p: st.salary.hasAnnuity ? base * 0.04 : 0, c: st.salary.hasAnnuity ? base * 0.08 : 0, name: '企业年金(4%|8%)' }
            };

            let pSec = 0, cSec = 0;
            for(let k in details) {
                pSec += details[k].p;
                cSec += details[k].c;
            }
            
            const totalCost = mGross + cSec; // 公司总用人成本
            
            // 3. 专项附加扣除
            let specDeductMonth = 0;
            for(let key in st.deductions) {
                const item = st.deductions[key];
                if(typeof item === 'boolean') {
                    if(item) specDeductMonth += 2000;
                } else {
                    if(item.active) specDeductMonth += item.value;
                }
            }
            
            // 4. 计算个税 (年化)
            const annualGross = mGross * 12;
            const annualSec = pSec * 12;
            const annualSpecDeduct = specDeductMonth * 12;
            const baseDeduct = 60000;
            
            let annualTaxable = Math.max(0, annualGross - annualSec - annualSpecDeduct - baseDeduct);
            let annualTax = 0;
            let bonusNet = 0;

            if (st.incomes.bonusTaxMode === 'combined') {
                annualTaxable += st.incomes.bonus;
                const tInfo = this.calcTaxRate(annualTaxable);
                annualTax = annualTaxable * tInfo.rate - tInfo.deduct;
                bonusNet = st.incomes.bonus; // 无法单独拆分，视为全额放入总池
            } else {
                const tInfo = this.calcTaxRate(annualTaxable);
                annualTax = annualTaxable * tInfo.rate - tInfo.deduct;
                if(st.incomes.bonus > 0) {
                    const bInfo = this.calcMonthlyBonusTaxRate(st.incomes.bonus / 12);
                    const bTax = st.incomes.bonus * bInfo.rate - bInfo.deduct;
                    bonusNet = st.incomes.bonus - bTax;
                }
            }
            
            const avgMonthlyTax = annualTax / 12;
            const mNet = mGross - pSec - avgMonthlyTax; // 均摊月到手
            
            const side = Number(st.incomes.side) || 0;
            const compensationMonthly = mNet + pSec + cSec;
            const secMonthly = pSec + cSec;
            const monthlyIn = mNet + side;
            let monthlyOut = 0;
            if(st.expensesList) st.expensesList.forEach(e => monthlyOut += e.amount);
            const monthlySave = monthlyIn - monthlyOut;
            const monthlySaveRate = monthlyIn > 0 ? (monthlySave / monthlyIn * 100) : 0;

            MVC.Model.cache.netMonthly = mNet;
            MVC.Model.cache.compensationMonthly = compensationMonthly;
            MVC.Model.cache.secMonthly = secMonthly;
            MVC.Model.cache.monthlyIn = monthlyIn;
            MVC.Model.cache.monthlyOut = monthlyOut;
            MVC.Model.cache.monthlySave = monthlySave;
            MVC.Model.cache.monthlySaveRate = monthlySaveRate;
            MVC.Model.cache.annualNet = mNet * 12 + bonusNet + (side * 12);
            MVC.Model.cache.annualSave = MVC.Model.cache.annualNet - (monthlyOut * 12);
            MVC.Model.cache.specDeductMonth = specDeductMonth;

            // 渲染工资 View (传入明细表)
            MVC.View.renderSalary(mNet, mGross, pSec, cSec, avgMonthlyTax, totalCost, compensationMonthly, secMonthly, specDeductMonth, bonusNet, details);
            MVC.View.renderCashflow(monthlyIn, monthlyOut, monthlySave, monthlySaveRate);
        },

        calcMortgageEngine(amountW, ratePct, years, paidM) {
            if(amountW<=0 || years<=0) return { pmt: 0, remP: 0, remI: 0 };
            const P = amountW * 10000;
            const r = ratePct / 100 / 12;
            const N = years * 12;
            const pmt = P * r * Math.pow(1+r, N) / (Math.pow(1+r, N) - 1);
            let remP = P;
            for(let i=0; i<Math.min(paidM, N); i++) {
                let interest = remP * r;
                remP -= (pmt - interest);
            }
            remP = Math.max(0, remP);
            const remN = N - paidM;
            let remI = Math.max(0, pmt * remN - remP);
            return { pmt, remP, remI, N, remN, r };
        },

        calcMortgage() {
            const m = MVC.Model.state.mortgage;
            const resC = this.calcMortgageEngine(m.cAmount, m.cRate, m.years, m.paidMonths);
            const resF = this.calcMortgageEngine(m.fAmount, m.fRate, m.years, m.paidMonths);
            const cPmt = resC.pmt;
            const fPmt = resF.pmt;
            const totalPmt = cPmt + fPmt;
            const totalRemP = (resC.remP + resF.remP) / 10000;
            const totalRemI = (resC.remI + resF.remI) / 10000;
            const ratio = MVC.Model.cache.netMonthly > 0 ? (totalPmt / MVC.Model.cache.netMonthly * 100) : 0;
            MVC.View.renderMortgage(cPmt, fPmt, totalPmt, ratio, totalRemP, totalRemI);
        },

        simulateEarlyRepay(amountW) {
            if(amountW === 0) { document.getElementById('early-repay-result').style.display = 'none'; return; }
            const m = MVC.Model.state.mortgage;
            const resC = this.calcMortgageEngine(m.cAmount, m.cRate, m.years, m.paidMonths);
            const resF = this.calcMortgageEngine(m.fAmount, m.fRate, m.years, m.paidMonths);
            const oldRemP = resC.remP + resF.remP;
            const oldRemI = resC.remI + resF.remI;
            
            let repayP = amountW * 10000;
            if(repayP > oldRemP) repayP = oldRemP;
            if(repayP <= 0) return;

            let newCRemP = resC.remP;
            let newFRemP = resF.remP;
            
            if(repayP >= newCRemP) {
                repayP -= newCRemP;
                newCRemP = 0;
                newFRemP -= repayP;
            } else {
                newCRemP -= repayP;
            }
            
            const calcNew = (newP, r, remN) => {
                if(newP<=0 || remN<=0) return {pmt:0, i:0};
                const pmt = newP * r * Math.pow(1+r, remN) / (Math.pow(1+r, remN) - 1);
                return { pmt: pmt, i: pmt*remN - newP };
            };

            const nC = calcNew(newCRemP, resC.r, resC.remN);
            const nF = calcNew(newFRemP, resF.r, resF.remN);

            const newTotalPmt = nC.pmt + nF.pmt;
            const newTotalI = nC.i + nF.i;
            const savedI = oldRemI - newTotalI;

            document.getElementById('early-repay-result').style.display = 'grid';
            document.getElementById('v-save-i').innerText = savedI.toLocaleString('zh-CN', {maximumFractionDigits:0});
            document.getElementById('v-new-pmt').innerText = newTotalPmt.toLocaleString('zh-CN', {maximumFractionDigits:0});
        },

        calcRetirement() {
            const r = MVC.Model.state.retire;
            let baseAge = r.type === 'male' ? 60 : (r.type === 'female-50' ? 50 : 55);
            const baseYear = 2025 - baseAge;
            const diffMonths = (r.birthYear - baseYear) * 12;
            let step = 4, maxDelay = 36;
            if(r.type === 'female-50') { step = 2; maxDelay = 60; }
            let delay = diffMonths >= 0 ? Math.min(Math.floor(diffMonths / step) + 1, maxDelay) : 0;
            const newAge = baseAge + (delay/12);
            
            const yrsLeft = newAge - (new Date().getFullYear() - r.birthYear);
            let pension = 0;
            if(yrsLeft > 0 && MVC.Model.state.salary.monthly > 0) {
                pension = MVC.Model.state.salary.monthly * 0.45 * Math.pow(1.03, yrsLeft);
            }
            MVC.View.renderRetirement(newAge, pension);
        },

        calcProjections() {
            const annualIn = MVC.Model.cache.annualNet;
            const monthlyOut = MVC.Model.cache.monthlyOut || 0;
            const annualOut = monthlyOut * 12;
            const annualSave = MVC.Model.cache.annualSave;
            const rate = annualIn > 0 ? (annualSave / annualIn * 100) : 0;

            const fireTarget = annualOut * 25;
            let fireYears = 0;
            if (annualSave > 0) {
                fireYears = fireTarget / annualSave;
            } else {
                fireYears = 999;
            }

            let goalYears = 0;
            const activeGoal = MVC.Model.state.goalsList ? MVC.Model.state.goalsList.find(g => g.id === MVC.Model.state.activeGoalId) : null;
            const targetAmount = activeGoal ? activeGoal.amount : 0;
            if (targetAmount > 0 && annualSave > 0) {
                goalYears = targetAmount / annualSave;
            }

            MVC.View.renderProjections(annualIn, annualOut, annualSave, rate, fireTarget, fireYears, goalYears);
        },

        generateAlerts() {
            const ratio = parseFloat(document.getElementById('v-m-ratio').innerText);
            const monthlySaveRate = MVC.Model.cache.monthlySaveRate || 0;
            const monthlySave = MVC.Model.cache.monthlySave || 0;

            let alertsHTML = '';
            if (ratio > 50) alertsHTML += `<div class="text-red-600 mb-1">⚠ 房贷占月薪 > 50%，现金流极为脆弱，请注意断供风险！</div>`;
            if (monthlySave < 0) alertsHTML += `<div class="text-red-600 mb-1">⚠ 每月可存为负，当前支出已经超过到手收入，请优先削减固定支出。</div>`;
            else if (monthlySaveRate < 10) alertsHTML += `<div class="text-orange-600 mb-1">⚠ 月度储蓄率极低 (<10%)，月光族预警，抗风险能力差。</div>`;
            if (alertsHTML === '') alertsHTML = `<div class="text-green-600">✅ 财富模型运行平稳，暂时没有发现致命风险。继续保持！</div>`;
            
            document.getElementById('risk-alerts').innerHTML = alertsHTML;
        },

        showToast(msg) {
            const t = document.getElementById('toast');
            document.getElementById('toast-msg').innerText = msg;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 2000);
        },

        triggerConfetti() {
            confetti({ particleCount: 150, spread: 80, origin: { y: 0.6 }, zIndex: 9999, colors: ['#4facfe', '#FFD54A', '#E74C3C', '#2ECC71'] });
        },

        generateShareCard() {
            const dateStr = new Date().toISOString().split('T')[0];
            document.getElementById('poster-date').innerText = dateStr;
            document.getElementById('p-net').innerText = Math.round(MVC.Model.cache.netMonthly);
            document.getElementById('p-comp').innerText = Math.round(MVC.Model.cache.compensationMonthly);
            document.getElementById('p-rate').innerText = parseFloat(document.getElementById('v-savings-rate').innerText).toFixed(0);
            document.getElementById('p-retire').innerText = parseFloat(document.getElementById('v-r-age').innerText).toFixed(1);
            document.getElementById('p-fire').innerText = parseFloat(document.getElementById('v-fire-years').innerText).toFixed(1);

            const container = document.getElementById('share-poster-container');
            container.style.top = '0'; container.style.left = '0'; container.style.zIndex = '9999';
            
            this.showToast("正在生成打工人专属海报...");
            setTimeout(() => {
                html2canvas(container, { scale: 2, useCORS: true, backgroundColor: '#ffffff' }).then(canvas => {
                    container.style.top = '-9999px'; container.style.zIndex = '-10';
                    const link = document.createElement('a');
                    link.download = `打工人报告_${dateStr}.png`;
                    link.href = canvas.toDataURL('image/png'); link.click();
                    this.showToast("✅ 海报生成成功，已下载！");
                });
            }, 500);
        }
    },

    View: {
        fm(num) { return Number(num).toLocaleString('zh-CN', {maximumFractionDigits:0}); },
        
        renderSalary(net, gross, pSec, cSec, mTax, totalCost, compensationMonthly, secMonthly, deduct, bonusNet, details) {
            document.getElementById('v-net-monthly').innerText = this.fm(net);
            document.getElementById('v-final-net').innerText = this.fm(net);
            document.getElementById('v-gross-monthly').innerText = this.fm(gross);
            document.getElementById('v-total-cost').innerText = this.fm(totalCost);
            document.getElementById('v-ind-tax').innerText = this.fm(mTax);
            
            document.getElementById('v-comp-monthly').innerText = this.fm(compensationMonthly);
            document.getElementById('v-sec-monthly').innerText = this.fm(secMonthly);
            document.getElementById('total-deduction-val').innerText = '¥' + deduct;
            document.getElementById('v-bonus-net').innerText = this.fm(bonusNet);
            
            // 渲染明细表格
            let html = '';
            for(let k in details) {
                if (details[k].p === 0 && details[k].c === 0 && k === 'annuity') continue;
                html += `
                    <tr class="border-b border-gray-200 border-dashed">
                        <td class="py-1.5 text-gray-600 font-bold">${details[k].name}</td>
                        <td class="py-1.5 text-right text-blue-600 font-mono">-¥${this.fm(details[k].p)}</td>
                        <td class="py-1.5 text-right text-red-500 font-mono">+¥${this.fm(details[k].c)}</td>
                    </tr>
                `;
            }
            html += `
                <tr class="font-black text-sm">
                    <td class="py-2 text-gray-800">合计</td>
                    <td class="py-2 text-right text-blue-700 font-mono">-¥${this.fm(pSec)}</td>
                    <td class="py-2 text-right text-red-600 font-mono">+¥${this.fm(cSec)}</td>
                </tr>
            `;
            document.getElementById('ins-detail-body').innerHTML = html;
        },

        renderCashflow(monthlyIn, monthlyOut, monthlySave, monthlySaveRate) {
            document.getElementById('v-monthly-in').innerText = this.fm(monthlyIn);
            document.getElementById('v-monthly-out').innerText = this.fm(monthlyOut);
            document.getElementById('v-monthly-save').innerText = this.fm(monthlySave);
            document.getElementById('v-monthly-save-rate').innerText = monthlySaveRate.toFixed(1);
            document.getElementById('v-yearly-save-est').innerText = this.fm(MVC.Model.cache.annualSave || 0);
        },

        renderMortgage(cPmt, fPmt, totalPmt, ratio, remP, remI) {
            document.getElementById('v-c-payment').innerText = this.fm(cPmt);
            document.getElementById('v-f-payment').innerText = this.fm(fPmt);
            document.getElementById('v-m-payment').innerText = this.fm(totalPmt);
            document.getElementById('v-m-ratio').innerText = ratio.toFixed(1) + '%';
            document.getElementById('v-m-remain-p').innerText = remP.toFixed(1);
            document.getElementById('v-m-remain-i').innerText = remI.toFixed(1);
        },

        renderRetirement(age, pension) {
            document.getElementById('v-r-age').innerText = age.toFixed(2);
            document.getElementById('v-r-pension').innerText = pension > 0 ? this.fm(pension) : '---';
        },

        renderProjections(anIn, anOut, anSave, rate, fTarget, fYears, gYears) {
            document.getElementById('v-annual-in').innerText = this.fm(anIn);
            document.getElementById('v-annual-out').innerText = this.fm(anOut);
            document.getElementById('v-annual-save').innerText = this.fm(anSave);
            document.getElementById('v-savings-rate').innerText = rate.toFixed(1) + '%';
            
            document.getElementById('v-fire-target').innerText = this.fm(fTarget);
            document.getElementById('v-fire-years').innerText = fYears > 100 ? '∞ ' : fYears.toFixed(1);
            
            document.getElementById('v-goal-save').innerText = '¥' + this.fm(anSave);
            document.getElementById('v-goal-years').innerText = gYears > 100 ? '∞' : gYears.toFixed(1);
        }
    }
};

