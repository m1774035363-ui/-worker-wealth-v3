<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>打工人财富引擎 V3.0 Pro</title>

<!-- Tailwind CSS -->
<script src="https://cdn.tailwindcss.com"></script>
<!-- FontAwesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<!-- Fonts -->
<link href="https://fonts.googleapis.com/css2?family=ZCOOL+KuaiLe&family=Nunito:wght@600;800;900&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
<!-- html2canvas (截图分享) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<!-- canvas-confetti (烟花特效) -->
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

<style>
:root {
    --c-ocean: #4facfe;
    --c-ocean-deep: #00f2fe;
    --c-krabby: #FFD54A;
    --c-ketchup: #E74C3C;
    --c-seaweed: #2ECC71;
    --c-wood: #FFF3E0;
    --c-wood-dark: #FFE0B2;
    --c-outline: #3E2723;
    --c-text: #4E342E;
}

body {
    background: linear-gradient(135deg, var(--c-ocean) 0%, var(--c-ocean-deep) 100%);
    background-attachment: fixed;
    color: var(--c-text);
    font-family: 'Nunito', 'Segoe UI', system-ui, sans-serif;
    margin: 0;
    overflow-x: hidden;
}
.font-cartoon { font-family: 'ZCOOL KuaiLe', cursive; }
.font-mono { font-family: 'JetBrains Mono', monospace; }

/* 气泡背景 */
.bubbles { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
.bubble { position: absolute; bottom: -20px; background: rgba(255, 255, 255, 0.2); border-radius: 50%; animation: rise infinite ease-in; }
@keyframes rise {
    0% { transform: translateY(0) translateX(0); opacity: 0; }
    50% { opacity: 1; }
    100% { transform: translateY(-120vh) translateX(-50px); opacity: 0; }
}

/* 统一组件样式 */
.kb-card {
    background: var(--c-wood); border: 3px solid var(--c-outline); border-radius: 16px;
    box-shadow: 6px 6px 0px var(--c-outline); margin-bottom: 24px; transition: transform 0.2s;
}
@media (max-width: 768px) { .kb-card { box-shadow: 4px 4px 0px var(--c-outline); border-width: 2px; padding: 16px !important; } }

.kb-btn {
    background: var(--c-wood-dark); border: 3px solid var(--c-outline); border-radius: 12px;
    box-shadow: 3px 4px 0px var(--c-outline); font-weight: 800; cursor: pointer; transition: all 0.1s;
    display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 16px;
}
.kb-btn:active { transform: translate(3px, 4px); box-shadow: 0px 0px 0px var(--c-outline); }
.kb-btn.active { background: var(--c-krabby); }
.kb-btn-red { background: var(--c-ketchup); color: white; }
.kb-btn-green { background: var(--c-seaweed); color: white; }
.kb-btn-blue { background: #3498DB; color: white; }
.kb-btn-small { min-height: 32px; padding: 0 10px; font-size: 0.875rem; border-width: 2px; box-shadow: 2px 2px 0px var(--c-outline); border-radius: 8px;}
.kb-btn-small:active { transform: translate(2px, 2px); box-shadow: 0px 0px 0px var(--c-outline); }

.kb-input, .kb-select {
    background: #fff; border: 3px solid var(--c-outline); border-radius: 12px; padding: 10px 14px;
    font-weight: bold; font-size: 16px; width: 100%; outline: none; transition: border-color 0.2s; min-height: 44px;
}
.kb-input:focus, .kb-select:focus { border-color: var(--c-ketchup); box-shadow: 0 0 0 3px rgba(231,76,60,0.2); }
.kb-input-small { min-height: 36px; padding: 6px 10px; border-width: 2px; border-radius: 8px;}

/* Checkbox 自定义 */
.spec-deduct-label {
    display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 0.875rem; font-weight: bold;
    background: white; padding: 8px; border-radius: 8px; border: 2px solid var(--c-outline); transition: all 0.2s;
}
.spec-deduct-label:hover { background: #f0f0f0; }
.spec-deduct-label input { width: 18px; height: 18px; accent-color: var(--c-krabby); cursor: pointer; }
.spec-deduct-label.active { background: var(--c-krabby); }

.progress-bar { height: 16px; border-radius: 8px; border: 2px solid var(--c-outline); overflow: hidden; background: #fff; }
.progress-fill { height: 100%; transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1); }

/* 分享海报专用隐藏层 */
#share-poster-container {
    position: fixed; top: -9999px; left: -9999px; width: 375px; background: linear-gradient(135deg, #fff 0%, #f3f4f6 100%);
    border-radius: 24px; padding: 24px; box-sizing: border-box; font-family: 'Nunito', sans-serif; color: #333; z-index: -10;
}

/* Toast */
#toast { position: fixed; top: 80px; left: 50%; transform: translateX(-50%); background: var(--c-seaweed); color: white; border: 3px solid var(--c-outline); padding: 12px 24px; border-radius: 12px; font-weight: bold; box-shadow: 3px 3px 0 var(--c-outline); z-index: 9999; opacity: 0; pointer-events: none; transition: opacity 0.3s; }
#toast.show { opacity: 1; }
</style>
</head>
<body class="pb-24">

<div class="bubbles" id="bubbles"></div>

<nav class="fixed top-0 left-0 right-0 py-3 px-4 md:px-8 flex justify-between items-center z-50 bg-[var(--c-wood)]/95 border-b-3 border-[var(--c-outline)] backdrop-blur-md">
    <div class="flex items-center gap-3">
        <div class="text-3xl drop-shadow-md">🍔</div>
        <div>
            <div class="font-cartoon font-bold text-xl md:text-2xl tracking-wide text-[var(--c-ketchup)]" style="-webkit-text-stroke: 1px var(--c-outline);">打工人财富引擎 V3</div>
        </div>
    </div>
</nav>

<div id="toast"><i class="fa-solid fa-check-circle mr-2"></i> <span id="toast-msg">操作成功</span></div>

<div class="max-w-6xl mx-auto pt-24 px-4" id="main-app">
    
    <!-- ================= 模块1：工资与五险二金 ================= -->
    <section id="salary" class="mb-10">
        <div class="flex items-center gap-3 mb-4">
            <h2 class="font-cartoon text-3xl text-white drop-shadow-lg" style="-webkit-text-stroke: 1.5px var(--c-outline);">🏙️ 薪资与社保明细</h2>
        </div>
        
        <div class="grid lg:grid-cols-5 gap-6">
            <div class="lg:col-span-2 kb-card p-5 bg-[#FFECB3] space-y-4">
                <!-- 城市选择 -->
                <div>
                    <label class="block font-bold mb-2">选择参保城市</label>
                    <select id="city-select" class="kb-select" onchange="MVC.Controller.changeCity(this.value)">
                        <!-- 动态填充 -->
                    </select>
                </div>
                
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block font-bold text-sm mb-2 text-gray-600">公积金比例</label>
                        <select id="hf-rate" class="kb-select kb-input-small text-sm" onchange="MVC.Controller.updateModel('salary', 'hfRate', Number(this.value))">
                            <option value="5">5%</option><option value="7">7%</option><option value="12">12%</option><option value="0">不缴</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-bold text-sm mb-2 text-gray-600">社保基数基准</label>
                        <select id="base-type" class="kb-select kb-input-small text-sm" onchange="MVC.Controller.updateModel('salary', 'baseType', this.value)">
                            <option value="actual">实际工资</option><option value="min">最低基数</option><option value="max">最高基数</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block font-bold mb-2">税前月薪 (元)</label>
                    <input type="number" id="salary-input" class="kb-input" value="15000" oninput="MVC.Controller.updateModel('salary', 'monthly', Number(this.value))">
                </div>

                <!-- 企业年金 -->
                <div class="flex justify-between items-center bg-white border-2 border-[var(--c-outline)] p-3 rounded-xl">
                    <span class="font-bold text-sm"><i class="fa-solid fa-piggy-bank text-purple-500"></i> 补充企业年金 (二金)</span>
                    <label class="spec-deduct-label !p-1 !m-0 !border-none !bg-transparent">
                        <input type="checkbox" id="annuity-check" onchange="MVC.Controller.updateModel('salary', 'hasAnnuity', this.checked)">
                    </label>
                </div>

                <!-- 专项附加扣除 -->
                <div class="border-t-2 border-dashed border-[var(--c-outline)] pt-4">
                    <label class="block font-bold mb-2 text-[var(--c-ketchup)]"><i class="fa-solid fa-file-invoice-dollar"></i> 个税专项附加扣除 (每月)</label>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-2" id="deductions-container">
                        <!-- 动态渲染 Checkboxes 与 Input -->
                    </div>
                    <div class="mt-2 text-xs font-bold text-gray-500 bg-white/50 p-2 rounded">
                        已选扣除额: <span id="total-deduction-val" class="text-red-500 font-mono text-sm">¥0</span> /月，自动抵扣个税
                    </div>
                </div>
            </div>
            
            <div class="lg:col-span-3 space-y-4">
                <div class="kb-card p-6 bg-white relative overflow-hidden flex flex-col justify-center">
                    <div class="flex flex-col md:flex-row gap-4">
                        <!-- 左侧到手金额与综合收入 -->
                        <div class="flex-1 relative z-10">
                            <div class="font-bold text-gray-500 mb-1">税后到手 (月净收)</div>
                            <div class="text-5xl font-black text-[var(--c-ketchup)] mb-2 font-mono">
                                <span class="text-2xl">¥</span><span id="v-net-monthly">0.00</span>
                            </div>
                            <div class="flex flex-wrap gap-2 mb-4">
                                <div class="text-xs font-bold bg-blue-100 text-blue-700 px-2 py-1 rounded-md border border-blue-300" title="税后到手 + 个人五险二金 + 公司五险二金">
                                    含五险二金综合月收入 ¥<span id="v-comp-monthly">0</span>
                                </div>
                                <div class="text-xs font-bold bg-purple-100 text-purple-700 px-2 py-1 rounded-md border border-purple-300" title="个人与公司每月缴入社保/公积金/企业年金账户的合计">
                                    五险二金月入账 ¥<span id="v-sec-monthly">0</span>
                                </div>
                            </div>
                            
                            <!-- 年终奖设置 -->
                            <div class="bg-blue-50 border border-blue-200 p-3 rounded-xl mt-auto">
                                <label class="block font-bold text-xs mb-1 text-blue-800"><i class="fa-solid fa-gift"></i> 年终奖金 (税前)</label>
                                <div class="flex items-center gap-2 mb-2">
                                    <input type="number" class="kb-input kb-input-small text-sm" id="bonus-input" oninput="MVC.Controller.updateModel('incomes', 'bonus', Number(this.value))">
                                </div>
                                <div class="flex gap-1 mb-2">
                                    <button class="kb-btn kb-btn-small flex-1 btn-tax-mode !text-xs !px-1" data-val="separate" onclick="MVC.Controller.updateModel('incomes', 'bonusTaxMode', 'separate')">单独计税</button>
                                    <button class="kb-btn kb-btn-small flex-1 btn-tax-mode !text-xs !px-1" data-val="combined" onclick="MVC.Controller.updateModel('incomes', 'bonusTaxMode', 'combined')">并入综合</button>
                                </div>
                                <div class="text-xs font-bold text-gray-600 flex justify-between">
                                    <span>年终奖税后到手:</span> <span class="font-black text-blue-700 font-mono">¥<span id="v-bonus-net">0</span></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="bg-gray-50 border-2 border-dashed border-gray-300 p-4 rounded-xl flex-1 text-sm shadow-inner relative overflow-hidden">
                            <div class="absolute top-0 left-0 right-0 bg-gray-700 text-white text-xs px-2 py-1.5 font-bold text-center shadow">五险二金与个税明细表</div>
                            <div class="mt-6 mb-2">
                                <table class="w-full text-xs text-left border-collapse">
                                    <thead>
                                        <tr class="text-gray-500 border-b-2 border-gray-300">
                                            <th class="pb-1 font-bold">项目 (费率)</th>
                                            <th class="pb-1 text-right font-bold text-blue-700">个人扣除</th>
                                            <th class="pb-1 text-right font-bold text-red-600">公司缴纳</th>
                                        </tr>
                                    </thead>
                                    <tbody id="ins-detail-body">
                                        <!-- JS rendering -->
                                    </tbody>
                                </table>
                            </div>
                            
                            <div class="bg-white p-3 rounded-lg border border-gray-200 mt-3 text-xs space-y-1.5 shadow-sm">
                                <div class="flex justify-between text-gray-800 font-bold"><span>名义月薪 (税前)</span><span class="font-mono text-sm">¥<span id="v-gross-monthly">0</span></span></div>
                                <div class="flex justify-between text-gray-800 font-bold border-b border-gray-200 pb-1 mb-1">
                                    <span class="text-[var(--c-ketchup)]"><i class="fa-solid fa-building"></i> 实际用人总成本</span>
                                    <span class="font-mono text-sm text-[var(--c-ketchup)]">¥<span id="v-total-cost">0</span></span>
                                </div>
                                <div class="flex justify-between text-gray-500"><span>个人所得税预估 (均摊)</span><span class="font-mono text-blue-600">-¥<span id="v-ind-tax">0</span></span></div>
                                <div class="flex justify-between text-green-700 font-black text-sm pt-1"><span>= 最终打卡到手</span><span class="font-mono">¥<span id="v-final-net">0</span></span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= 模块2：收支记账盘 ================= -->
    <section id="savings" class="mb-10">
        <div class="flex items-center gap-3 mb-4">
            <h2 class="font-cartoon text-3xl text-white drop-shadow-lg" style="-webkit-text-stroke: 1.5px var(--c-outline);">📊 财务基本盘 (月度)</h2>
        </div>
        
        <div class="kb-card p-5 bg-[#E1F5FE]">
            <div class="grid md:grid-cols-2 gap-6">
                <!-- 开支清单 -->
                <div>
                    <div class="flex justify-between items-center mb-3">
                        <label class="font-bold text-gray-700"><i class="fa-solid fa-cart-shopping text-blue-500"></i> 每月固定消费清单</label>
                        <button onclick="MVC.Controller.addExpense()" class="kb-btn kb-btn-green kb-btn-small"><i class="fa-solid fa-plus mr-1"></i> 记一笔</button>
                    </div>
                    <div id="expense-list" class="space-y-2 max-h-[220px] overflow-y-auto pr-2 mb-3">
                        <!-- JS 渲染消费项 -->
                    </div>
                    <div class="flex justify-between items-center border-t-2 border-dashed border-gray-400 pt-3">
                        <span class="font-black text-gray-700">总月开销:</span>
                        <span id="v-exp-val" class="text-red-500 font-black font-mono text-xl">¥0</span>
                    </div>
                </div>

                <!-- 额外收入与年度结余 -->
                <div class="space-y-4">
                    <div class="bg-white p-4 rounded-xl border-2 border-[var(--c-outline)]">
                        <label class="font-bold text-sm flex justify-between mb-2">
                            <span><i class="fa-solid fa-sack-dollar text-green-500"></i> 副业/外快收入 (月度)</span>
                        </label>
                        <input type="number" class="kb-input" id="monthly-side-input" placeholder="输入每月额外赚的钱" oninput="MVC.Controller.updateModel('incomes', 'side', Number(this.value))">
                    </div>

                    <div class="bg-white p-4 rounded-xl border-2 border-[var(--c-outline)] shadow-[4px_4px_0px_#4E342E]">
                        <h3 class="font-black text-gray-700 mb-3 border-b-2 border-gray-100 pb-2">年度财富结算单</h3>
                        <div class="space-y-2">
                            <div class="flex justify-between text-sm font-bold">
                                <span class="text-gray-500">年总净收入</span>
                                <span class="font-mono text-blue-600">¥<span id="v-annual-in">0</span></span>
                            </div>
                            <div class="flex justify-between text-sm font-bold">
                                <span class="text-gray-500">年总支出</span>
                                <span class="font-mono text-red-500">-¥<span id="v-annual-out">0</span></span>
                            </div>
                            <div class="flex justify-between items-center pt-2 border-t-2 border-dashed border-gray-200">
                                <span class="font-black text-gray-800">当年可存下 (结余)</span>
                                <span class="font-mono font-black text-2xl text-[var(--c-seaweed)]">¥<span id="v-annual-save">0</span></span>
                            </div>
                            <div class="text-right text-xs font-bold text-gray-400 mt-1">
                                储蓄率: <span id="v-savings-rate" class="text-black">0%</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-6 bg-white p-4 rounded-xl border-2 border-[var(--c-outline)]">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div>
                        <div class="text-xs font-bold text-gray-500 mb-1">每月到手（工资+副业）</div>
                        <div class="font-black font-mono text-lg text-blue-600">¥<span id="v-monthly-in">0</span></div>
                    </div>
                    <div>
                        <div class="text-xs font-bold text-gray-500 mb-1">每月总支出</div>
                        <div class="font-black font-mono text-lg text-red-500">-¥<span id="v-monthly-out">0</span></div>
                    </div>
                    <div>
                        <div class="text-xs font-bold text-gray-500 mb-1">每月能存下</div>
                        <div class="font-black font-mono text-lg text-[var(--c-seaweed)]">¥<span id="v-monthly-save">0</span></div>
                    </div>
                    <div>
                        <div class="text-xs font-bold text-gray-500 mb-1">月度储蓄率</div>
                        <div class="font-black font-mono text-lg text-amber-600"><span id="v-monthly-save-rate">0</span>%</div>
                    </div>
                </div>
                <div class="mt-3 pt-3 border-t-2 border-dashed border-gray-200 flex flex-col md:flex-row md:justify-between md:items-center gap-1 text-sm font-bold text-gray-700">
                    <span>全年预计可存（含年终奖税后）</span>
                    <span class="font-mono text-green-600">¥<span id="v-yearly-save-est">0</span></span>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= 模块3：房贷与减压 ================= -->
    <section id="mortgage" class="mb-10">
        <div class="flex items-center gap-3 mb-4">
            <h2 class="font-cartoon text-3xl text-white drop-shadow-lg" style="-webkit-text-stroke: 1.5px var(--c-outline);">⚓ 房贷压力测试</h2>
        </div>
        
        <div class="grid lg:grid-cols-2 gap-6">
            <div class="kb-card p-5 bg-[#E8F5E9] space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div class="bg-white p-3 rounded-xl border-2 border-[var(--c-outline)]">
                        <div class="font-black text-sm mb-2 text-amber-600">商业贷款</div>
                        <div class="mb-2"><label class="text-xs font-bold text-gray-500">本金(万)</label><input type="number" class="kb-input kb-input-small" id="c-amount" oninput="MVC.Controller.updateModel('mortgage', 'cAmount', Number(this.value))"></div>
                        <div class="mb-2"><label class="text-xs font-bold text-gray-500">利率(%)</label><input type="number" class="kb-input kb-input-small" id="c-rate" step="0.01" oninput="MVC.Controller.updateModel('mortgage', 'cRate', Number(this.value))"></div>
                    </div>
                    <div class="bg-white p-3 rounded-xl border-2 border-[var(--c-outline)]">
                        <div class="font-black text-sm mb-2 text-green-600">公积金贷款</div>
                        <div class="mb-2"><label class="text-xs font-bold text-gray-500">本金(万)</label><input type="number" class="kb-input kb-input-small" id="f-amount" oninput="MVC.Controller.updateModel('mortgage', 'fAmount', Number(this.value))"></div>
                        <div class="mb-2"><label class="text-xs font-bold text-gray-500">利率(%)</label><input type="number" class="kb-input kb-input-small" id="f-rate" step="0.01" oninput="MVC.Controller.updateModel('mortgage', 'fRate', Number(this.value))"></div>
                    </div>
                </div>
                
                <div class="flex gap-4 items-center">
                    <div class="flex-1">
                        <label class="text-xs font-bold text-gray-500 block mb-1">贷款年限(年)</label>
                        <input type="number" class="kb-input kb-input-small" id="m-years" oninput="MVC.Controller.updateModel('mortgage', 'years', Number(this.value))">
                    </div>
                    <div class="flex-1">
                        <label class="text-xs font-bold text-gray-500 block mb-1">已还期数(月)</label>
                        <input type="number" class="kb-input kb-input-small" id="m-paid" oninput="MVC.Controller.updateModel('mortgage', 'paidMonths', Number(this.value))">
                    </div>
                </div>
            </div>

            <div class="space-y-4">
                <!-- 常规房贷信息 -->
                <div class="kb-card p-5 bg-white !mb-0 flex flex-col md:flex-row md:justify-between md:items-center gap-4">
                    <div>
                        <div class="text-sm font-bold text-gray-500 mb-3">当前每月房贷 (等额本息)</div>
                        <div class="flex gap-8 mb-3 flex-wrap">
                            <div>
                                <div class="text-xs font-bold text-gray-500 mb-1">商业贷款月供</div>
                                <div class="text-2xl font-black font-mono text-amber-600">¥<span id="v-c-payment">0.00</span></div>
                            </div>
                            <div>
                                <div class="text-xs font-bold text-gray-500 mb-1">公积金贷款月供</div>
                                <div class="text-2xl font-black font-mono text-green-600">¥<span id="v-f-payment">0.00</span></div>
                            </div>
                        </div>
                        <div class="flex items-end gap-3 flex-wrap">
                            <div>
